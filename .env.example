# Flask Configuration
SECRET_KEY=your-secret-key-here-change-in-production
FLASK_ENV=development
FLASK_DEBUG=True

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost/networth_tracker
# For development, you can use SQLite:
# DATABASE_URL=sqlite:///networth.db

# API Keys
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-api-key-here
YAHOO_FINANCE_ENABLED=true

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Email Configuration (optional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Security
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ACCESS_TOKEN_EXPIRES=3600

# External APIs
BANK_OF_CANADA_API_URL=https://www.bankofcanada.ca/valet/observations/
PRECIOUS_METALS_API_KEY=your-precious-metals-api-key

# Application Settings
DEFAULT_CURRENCY=CAD
DEFAULT_TIMEZONE=America/Toronto
MAX_UPLOAD_SIZE=16777216  # 16MB

# Development Settings
DEBUG_TOOLBAR=false
PROFILER_ENABLED=false
